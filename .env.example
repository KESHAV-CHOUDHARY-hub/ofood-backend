# OFOOD Backend - Environment Variables Example
# DO NOT put real secrets in this file. Copy to .env and fill in values.

# Database Configuration (Overrides application-dev.yml defaults)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ofood
# DB_USERNAME=ofood
DB_PASSWORD=

# JWT Configuration
OFOOD_JWT_PRIVATE_KEY_PATH=/path/to/your/dev-private.pem
OFOOD_JWT_PUBLIC_KEY_PATH=/path/to/your/dev-public.pem

# CORS / Frontend Configuration
OFOOD_FRONTEND_URL=http://localhost:5173

# Cookie Configuration (Uncomment for cross-origin production deployment)
# OFOOD_REFRESH_TOKEN_SAME_SITE=None
# OFOOD_REFRESH_TOKEN_SECURE=true
